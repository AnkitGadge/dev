	public String fetchPatientSearch(String data, String uiToJavaEncryptionKey,String javaToDbDbToJavaEncyDecryKey) {

		data = BillingUtill.dataDecryption(data, uiToJavaEncryptionKey);

		String[] searchArray = (data.toUpperCase().replace("\\s", " ")).split(" ");

		StringBuilder searchKey = new StringBuilder(
				BillingUtill.dataEncryption(searchArray[0].trim(), javaToDbDbToJavaEncyDecryKey));

		if (searchArray.length >= 2) {

			searchKey=searchKey.append(BillingUtill.dataEncryption(searchArray[1].trim(), javaToDbDbToJavaEncyDecryKey));
		}
		if (searchArray.length >= 3) {
			searchKey=searchKey.append(BillingUtill.dataEncryption(searchArray[2].trim(), javaToDbDbToJavaEncyDecryKey));
		}

		return searchKey.toString();
	}
