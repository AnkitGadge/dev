		updatePatientBean.setOrgTimezone(updatePatientReq.getOrgTimezone());
		updatePatientBean.setIsHealCardPatient(updatePatientReq.getIsHealthCardPatient());
		updatePatientBean.setPatientId(updatePatientReq.getPatientId());
		updatePatientBean.setHosPatientId(dataDecryption(updatePatientReq.getHosPatientId(), key));
