	 * Upload file into S3
	 * 
	 * @param bucketNm            name of the bucket
	 * @param fileNmWithExtension file name with extension
	 * @param multipart           multipart file
	 * @throws IOException
	 * @return the file URL
	 * 
	 * 
	 * 
	 */

	public String fileUpload(String bucketNm, String fileNmWithExtension, MultipartFile multipart, String folderNm)
			throws IOException {

		if (StringUtils.isBlank(fileNmWithExtension)) {

			fileNmWithExtension = Timestamp.valueOf(LocalDateTime.now()).getTime() + "";
		}

		return upload(bucketNm, fileNmWithExtension, multipart, folderNm);
	}

	public String upload(String bucketNm, String fileNmWithExtension, MultipartFile multipart, String folderNm)
			throws IOException {

		HttpHeaders headers = new HttpHeaders();

		// getting service URL for Rest call
		ServiceInstance serviceInstance = loadBalancer.choose("utility-service");

		String url = serviceInstance.getUri().toString() + "/fileUpload";

		// setting Headers for content type
		headers.setContentType(MediaType.MULTIPART_FORM_DATA);
		// headers.add("Tx-Id", httpServletResponse.getHeader("Tx-Id"));

		MultiValueMap<String, Object> map = new LinkedMultiValueMap<String, Object>();

		map.add("storageLocation", bucketNm);

		map.add("filePath", fileNmWithExtension);

		// map.add("folderNm", folderNm);
		if (multipart != null && multipart.getBytes().length > 0) {

			// creating a resource with multipart file data
			ByteArrayResource contentsAsResource = new ByteArrayResource(multipart.getBytes()) {
				@Override
				public String getFilename() {
					return fileNmWithExtension;
				}
			};
			map.add("multipartFile", contentsAsResource);

			// creating Entity for rest call
			HttpEntity<MultiValueMap<String, Object>> requestEntity = new HttpEntity<>(map, headers);

			ResponseEntity<ResponseMapper> exchange = restTemplate.exchange(url, HttpMethod.POST, requestEntity,
					ResponseMapper.class);

			if (exchange != null && exchange.getStatusCodeValue() == HttpStatus.OK.value()) {
				return exchange.getBody().getData() + "";
			}

		}
		return null;

	}

	public FileDownloadRes fileDownload(String bucketNm, String filePath, String folderNm)
			throws UnsupportedEncodingException {

		HttpHeaders headers = new HttpHeaders();
		String fileNm = filePath;
		if (filePath != null)
			fileNm = URLDecoder.decode(filePath,
					StandardCharsets.UTF_8.name());/* Decoding the encoded characters in URL */

		// getting service URL for Rest call
		ServiceInstance serviceInstance = loadBalancer.choose("utility-service");

		String url = serviceInstance.getUri().toString() + "/download";

		// setting Headers for content type
		// headers.setContentType(MediaType.APPLICATION_JSON);
		// headers.add("Tx-Id", httpServletResponse.getHeader("Tx-Id"));

		S3FileUploadBean request = new S3FileUploadBean();
		request.setFilePath(fileNm);
		request.setStorageLocation(bucketNm);

		MultiValueMap<String, Object> map = new LinkedMultiValueMap<String, Object>();

		map.add("storageLocation", bucketNm);

		map.add("filePath", fileNm);

		ResponseEntity<ByteArrayResource> exchange = restTemplate.exchange(url, HttpMethod.POST,
				new HttpEntity<>(map, headers), ByteArrayResource.class);

		if (exchange != null && exchange.getStatusCodeValue() == HttpStatus.OK.value()) {

			FileDownloadRes response = new FileDownloadRes();
			response.setFileName(fileNm);

			response.setFileData(exchange.getBody().getByteArray());

			return response;
		}

		return null;

	}
