		insertPatientBean
				.setEmergencyContactLocation(checkEachVariableForNull(insertPatientReq.getEmergencyContactLocation()));
		insertPatientBean.setIsEmergencyContactGuanrantor(insertPatientReq.getIsEmergencyContactGuanrantor());

		insertPatientBean.setGuarantorContactNm(checkEachVariableForNull(insertPatientReq.getGuarantorContactNm()));
		insertPatientBean.setGuarantorRelationshipCode(
				checkEachVariableForNull(insertPatientReq.getGuarantorRelationshipCode()));
		insertPatientBean.setGuarantorContactNo(checkEachVariableForNull(insertPatientReq.getGuarantorContactNo()));
		insertPatientBean
				.setGuarantorContactEmailId(checkEachVariableForNull(insertPatientReq.getGuarantorContactEmailId()));
		insertPatientBean
				.setGuarantorContactAddress(checkEachVariableForNull(insertPatientReq.getGuarantorContactAddress()));
		insertPatientBean.setOrgId(insertPatientReq.getOrgId());
		insertPatientBean.setOrgGrpId(insertPatientReq.getOrgGrpId());
		insertPatientBean.setCreatedUsrId(insertPatientReq.getCreatedUsrId());
		insertPatientBean
