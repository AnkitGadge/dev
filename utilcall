	/**
	 * Which returns the age of a person with a proper value.
	 * 
	 * @param dateOfBirth fomrat (yyyy-MM-dd)
	 * @param age
	 * @return String converted Age
	 */
	public static String getAge(String dateOfBirth, String age, Date createdDttm) {
		StringBuilder patientTotalAge = new StringBuilder();
		// If we have date of birth. Then we are calculating age.
		if (dateOfBirth != null && dateOfBirth.contains("-") && !dateOfBirth.isEmpty()) {
			LocalDate today = LocalDate.now(); // Today's date
			LocalDate birthday = LocalDate.parse(dateOfBirth); // Birth date

			Period p = Period.between(birthday, today.plusDays(1));
			int years = p.getYears();
			int months = p.getMonths();
			int days = p.getDays();
			String patientDays = null;

			patientTotalAge.append(years + "Y ");
			patientTotalAge.append(months + "M ");
			if (days != 0) {
				patientDays = days + "D";
			} else {
				patientDays = 1 + "D";
			}
			patientTotalAge.append(patientDays);
			return patientTotalAge.toString();
		} else {
			if (age != null && !age.isEmpty()) {
				long diff = new Date().getTime() - createdDttm.getTime();
				Long diffDate = TimeUnit.DAYS.convert(diff, TimeUnit.MILLISECONDS);
				/*
				 * If we don't have date of birth. Then we are showing age as it is in DB by
				 * converting into years.
				 */
				Integer convertedAge = Integer.parseInt(age);
				convertedAge = convertedAge + diffDate.intValue();
				Integer years = null;
				Integer months = null;
				Integer days = null;
				if (convertedAge > 0) {
					years = convertedAge / 365;
					months = (convertedAge % 365) / 30;
					days = (convertedAge % 365) % 30;

					if (years == 0 && months == 0 && days == 0) {
						days = 1;
					} else if (years == 0 && months == 0 && days == 1) {
						days = 2;
					}

					patientTotalAge.append(years + "Y ").append(months).append("M ").append(days).append("D");
				} else {
					patientTotalAge.append("0Y 0M 0D");
				}
			} else {
				patientTotalAge.append("0Y 0M 0D");
			}
		}
		return patientTotalAge.toString();
	}

