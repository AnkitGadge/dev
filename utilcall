	/**
	 * Below method is used to encrypt the data
	 * 
	 * @param data
	 * @param key
	 * @return
	 */
	public static String dataEncryption(String data, String key) {
		if (StringUtils.isNotBlank(data)) {
			// rebuild key using SecretKeySpec
			byte[] decodedKey = Base64.decodeBase64(key);
			SecretKey originalKey = new SecretKeySpec(decodedKey, "AES");
			// AES defaults to AES/ECB/PKCS5Padding in Java 7
			Cipher aesCipher = null;
			byte[] byteCipherText = null;
			try {
				aesCipher = Cipher.getInstance("AES");
				aesCipher.init(Cipher.ENCRYPT_MODE, originalKey);
				byteCipherText = aesCipher.doFinal(data.trim().getBytes());
			} catch (NoSuchAlgorithmException | NoSuchPaddingException | InvalidKeyException | IllegalBlockSizeException
					| BadPaddingException e) {
				e.printStackTrace();
			}

			return Base64.encodeBase64String(byteCipherText);
		} else {
			return null;
		}
	}

	/**
	 * Below method is used to decrypt the encrypted data
	 * 
	 * @param args
	 */
	public static String dataDecryption(String encryptData, String key) {
		if (StringUtils.isNotBlank(encryptData) && !encryptData.trim().equals("null")) {
			// rebuild key using SecretKeySpec

			byte[] decodedKey = Base64.decodeBase64(key);
			SecretKey originalKey = new SecretKeySpec(decodedKey, "AES");
			Cipher aesCipher;
			byte[] bytePlainText = null;
			try {
				aesCipher = Cipher.getInstance("AES");
				aesCipher.init(Cipher.DECRYPT_MODE, originalKey);
				bytePlainText = aesCipher.doFinal(Base64.decodeBase64(encryptData.trim().replace(" ", "+")));
			} catch (NoSuchAlgorithmException | NoSuchPaddingException | InvalidKeyException | IllegalBlockSizeException
					| BadPaddingException e) {
				e.printStackTrace();
			}
			if (bytePlainText != null) {

				return new String(bytePlainText);
			}
		}
		return null;
	}

	/**
	 * Below method is used to decrypt patient demographic details which are
	 * encrypted in UI
	 * 
	 * @param insertPatientReq
	 * @return
	 */
	public InsertPatientBean decryptPatientDemographicDetails(InsertPatientReq insertPatientReq, String key,
			String javaToDbKey) {

		InsertPatientBean insertPatientBean = new InsertPatientBean();
		insertPatientBean.setOrgId(insertPatientReq.getOrgId());
		insertPatientBean.setIsAppointment(insertPatientReq.getIsAppointment());
		insertPatientBean.setIsHealthCardPatient(insertPatientReq.getIsHealthCardPatient());
		if (StringUtils.isNotBlank(insertPatientReq.getIsEmergencyPatient())
				&& !insertPatientReq.getIsEmergencyPatient().equalsIgnoreCase("null")) {
			insertPatientBean.setIsEmergencyPatient(Boolean.parseBoolean(insertPatientReq.getIsEmergencyPatient()));
		}
		insertPatientBean.setHonorificNm(dataDecryption(insertPatientReq.getHonorificNm(), key));
		insertPatientBean.setFirstNm(dataDecryption(insertPatientReq.getFirstNm(), key));
		insertPatientBean.setEncryptedFirstNm(dataEncryption(insertPatientBean.getFirstNm(), javaToDbKey));

		insertPatientBean.setMiddleNm(dataDecryption(insertPatientReq.getMiddleNm(), key));
		insertPatientBean.setEncryptedMiddleNm(dataEncryption(insertPatientBean.getMiddleNm(), javaToDbKey));
		insertPatientBean.setLastNm(dataDecryption(insertPatientReq.getLastNm(), key));
		insertPatientBean.setEncryptedLastNm(dataEncryption(insertPatientBean.getLastNm(), javaToDbKey));

		insertPatientBean.setGender(dataDecryption(insertPatientReq.getGender(), key));
		insertPatientBean.setMobileNo(dataDecryption(insertPatientReq.getMobileNo(), key));
		insertPatientBean.setEncryptedMobileNo(dataEncryption(insertPatientBean.getMobileNo(), javaToDbKey));

		if (StringUtils.isNotBlank(insertPatientReq.getBirthDt())) {
			DateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd");
			String birthDt = dataDecryption(insertPatientReq.getBirthDt(), key);
			try {
				if (StringUtils.isNotBlank(birthDt)) {
					insertPatientBean.setBirthDt(dateFormat.parse(birthDt));
				}
			} catch (ParseException e) {
				e.printStackTrace();
			}
		}
		if (StringUtils.isNotBlank(insertPatientReq.getAge()) && !insertPatientReq.getAge().trim().equals("null")) {
			insertPatientBean.setAge(Integer.parseInt(dataDecryption(insertPatientReq.getAge(), key)));
		}
		insertPatientBean.setAlternateContactNo(dataDecryption(insertPatientReq.getAlternateContactNo(), key));
		insertPatientBean.setEmailId(dataDecryption(insertPatientReq.getEmailId(), key));
		if (StringUtils.isNotBlank(insertPatientReq.getAadhaarNo())) {
			insertPatientBean.setAadhaarNo(Long.parseLong(dataDecryption(insertPatientReq.getAadhaarNo(), key)));
			insertPatientBean
					.setEncryptedAadhaarNo(dataEncryption(insertPatientBean.getAadhaarNo().toString(), javaToDbKey));
		}

		if (StringUtils.isNotBlank(insertPatientReq.getBloodGrpNm())) {
			insertPatientBean.setBloodGrpNm(dataDecryption(insertPatientReq.getBloodGrpNm(), key));
		}
		insertPatientBean.setPatientWorkingType(checkEachVariableForNull(insertPatientReq.getPatientWorkingType()));
		insertPatientBean.setWorkingOrgNm(checkEachVariableForNull(insertPatientReq.getWorkingOrgNm()));
		insertPatientBean.setDesignationNm(checkEachVariableForNull(insertPatientReq.getDesignationNm()));
		insertPatientBean.setPhoneNo(checkEachVariableForNull(insertPatientReq.getPhoneNo()));
		insertPatientBean.setWorkEmail(checkEachVariableForNull(insertPatientReq.getWorkEmail()));
		insertPatientBean.setWorkAddress(checkEachVariableForNull(insertPatientReq.getWorkAddress()));

		insertPatientBean.setAddressLine1(dataDecryption(insertPatientReq.getAddressLine1(), key));
		insertPatientBean.setLocalityNm(dataDecryption(insertPatientReq.getLocalityNm(), key));
		insertPatientBean.setCityNm(dataDecryption(insertPatientReq.getCityNm(), key));
		insertPatientBean.setDistrictNm(dataDecryption(insertPatientReq.getDistrictNm(), key));
		insertPatientBean.setStateNm(dataDecryption(insertPatientReq.getStateNm(), key));
		insertPatientBean.setCountryNm(dataDecryption(insertPatientReq.getCountryNm(), key));
		if (StringUtils.isNotBlank(insertPatientReq.getPincode())) {
			insertPatientBean.setPincode(Integer.parseInt(dataDecryption(insertPatientReq.getPincode(), key)));
		}
		if (insertPatientReq.getImagePath() != null) {
			insertPatientBean.setMultipart(insertPatientReq.getImagePath());
		}

		insertPatientBean.setIsAddressPermanent(insertPatientReq.getIsAddressPermanent());
		insertPatientBean.setPermAddressLine1(dataDecryption(insertPatientReq.getPermAddressLine1(), key));
		insertPatientBean.setPermLocalityNm(dataDecryption(insertPatientReq.getPermLocalityNm(), key));
		if (StringUtils.isNotBlank(insertPatientReq.getPermPincode())
				&& insertPatientReq.getPermPincode().length() > 3) {
			insertPatientBean.setPermPincode(Integer.parseInt(dataDecryption(insertPatientReq.getPermPincode(), key)));
		}
		insertPatientBean.setPermCountryNm(dataDecryption(insertPatientReq.getPermCountryNm(), key));
		insertPatientBean.setPermStateNm(dataDecryption(insertPatientReq.getPermStateNm(), key));
		insertPatientBean.setPermDistrictNm(dataDecryption(insertPatientReq.getPermDistrictNm(), key));
		insertPatientBean.setPermCityNm(dataDecryption(insertPatientReq.getPermCityNm(), key));

		insertPatientBean.setEmergencyContactNm(checkEachVariableForNull(insertPatientReq.getEmergencyContactNm()));
		insertPatientBean.setRelationshipCode(checkEachVariableForNull(insertPatientReq.getRelationshipCode()));
