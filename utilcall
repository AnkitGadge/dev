	public String checkEachVariableForNull(String key) {

		if (StringUtils.isNotBlank(key)
				&& ("null".equalsIgnoreCase(key.trim()) || "undefined".equalsIgnoreCase(key.trim()))) {
			return null;
		} else if (StringUtils.isNotBlank(key)) {
			return key.trim();
		}

		return key;
	}

