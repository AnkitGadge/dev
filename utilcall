		insertPatientBean.setReferenceNo(checkEachVariableForNull(insertPatientReq.getReferenceNo()));
		insertPatientBean.setFingerPrintDetails(insertPatientReq.getFingerPrintDetails());
		insertPatientBean.setIsPatientDonateBlood(insertPatientReq.getIsPatientDonateBlood());

		// Custom fields
		insertPatientBean
				.setCustomEmploymentField(checkEachVariableForNull(insertPatientReq.getCustomEmploymentField()));
		insertPatientBean
				.setCustomOtherDetailsField(checkEachVariableForNull(insertPatientReq.getCustomOtherDetailsField()));
		insertPatientBean
				.setCustomContactPersonField(checkEachVariableForNull(insertPatientReq.getCustomContactPersonField()));
		insertPatientBean.setCustomAddressField(checkEachVariableForNull(insertPatientReq.getCustomAddressField()));
